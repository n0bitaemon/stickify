# Copy to .env and adjust. The server reads this file on `npm run dev` / `npm start`.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/stickify

# MUST be changed in production (at least 16 random characters): openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-please
JWT_EXPIRES_IN=7d

# Where originals, thumbnails, renditions and ZIPs are stored (default ./server/storage)
# STORAGE_DIR=/var/lib/stickify

MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=60
# sharp/ffmpeg tasks running in parallel – roughly CPU cores / 2
PROCESSING_CONCURRENCY=2
# Export/import jobs running in parallel
JOB_CONCURRENCY=3

# Telegram: create a bot with @BotFather and paste its token to enable link imports,
# the sticker-receiving bot and pushing packs to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_POLLING=true

# Only needed when ffmpeg is not on PATH
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Only needed when the frontend runs on another origin WITHOUT the Vite proxy
# CORS_ORIGIN=http://localhost:5173
